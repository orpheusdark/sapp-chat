NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/sapphire_chat?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set 1 on Render, behind its single trusted reverse proxy; 0 locally.
TRUST_PROXY=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Seed is opt-in; never use the example password in production.
SEED_PASSWORD=
